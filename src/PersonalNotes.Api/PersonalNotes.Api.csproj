<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- dotnet user-secrets: la API Key de Gemini fuera del repo en desarrollo -->
    <UserSecretsId>personal-notes-service-8f3c2a1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersonalNotes.Application\PersonalNotes.Application.csproj" />
    <ProjectReference Include="..\PersonalNotes.Infrastructure\PersonalNotes.Infrastructure.csproj" />
  </ItemGroup>

</Project>
